---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---
<Base
  title="Page not found | SafOil"
  description="This page doesn't exist. Explore SafOil's biofuel feedstock products, market insights, or request pricing from our trade desk."
  canonical="https://safoil.my/404"
  noindex={true}
>
  <section class="subpage-hero">
    <div class="wrap">
      <span class="eyebrow">Error 404</span>
      <h1>This cargo didn't make it to port.</h1>
      <p class="lede">The page you're looking for has moved or never existed. Here's where most visitors are headed instead.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
        <a href="/#quote" class="btn">Request pricing</a>
        <a href="/products/biofuel-feedstock-malaysia" class="btn btn-ghost">View products</a>
        <a href="/blog/" class="btn btn-ghost">Read insights</a>
      </div>
    </div>
  </section>

  <section class="content">
    <div class="wrap">
      <span class="eyebrow">Latest from the trade desk</span>
      <ul style="list-style:none;padding:0;margin:18px 0 0;display:flex;flex-direction:column;gap:14px">
        {latest.map((post) => (
          <li><a href={`/blog/${post.slug}/`} style="color:inherit;font-weight:600">{post.data.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>
